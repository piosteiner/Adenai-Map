#!/bin/bash
# Before a push (the map goes live on GitHub Pages with it): the unit tests and the browser tests (server/test).
# Enabled once per checkout: git config core.hooksPath scripts/githooks. In an emergency: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)/server"
echo "▶ unit tests"
npm test --silent 2>&1 | grep -E "^# (pass|fail)|^not ok" || true
npm test --silent >/dev/null 2>&1 || { echo "✗ unit tests failed — npm test (in server/)"; exit 1; }
echo "▶ browser tests"
npx playwright test --reporter=line || { echo "✗ browser tests failed — npx playwright test (in server/)"; exit 1; }

{
  "name": "adenai-md-editor",
  "private": true,
  "description": "Front-end builds of the Adenai CMS: the [[link]] editor for the classic CMS and the new CMS (v2). npm run build / build:cms",
  "scripts": {
    "build": "npm run build:map && npm run build:cms",
    "build:cms": "esbuild cms/main.js --bundle --minify --format=iife --target=es2020 --loader:.png=dataurl --loader:.svg=dataurl --outfile=../admin-interface/v2/app.js && cp ../../src/utils/rich-text.js ../admin-interface/v2/rich-text.js && node -e \"const fs=require('fs');const f='../admin-interface/v2/index.html';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/v=[^\\\"]+/g,'v='+Date.now().toString(36)))\"",
    "build:map": "esbuild md-editor.js --bundle --minify --format=iife --target=es2020 --outfile=../../src/vendor/md-editor.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "leaflet": "^1.9.4",
    "lib0": "^0.2.119",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}

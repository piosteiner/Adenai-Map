{
  "name": "adenai-md-editor",
  "private": true,
  "description": "Markdown editor with [[links]] for the Adenai admin. Build: npm run build → ../admin-interface/js/libs/md-editor.js",
  "scripts": {
    "build": "esbuild md-editor.js --bundle --minify --format=iife --target=es2020 --outfile=../admin-interface/js/libs/md-editor.js && cp ../../src/utils/rich-text.js ../admin-interface/js/core/rich-text.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2"
  }
}

# Installed at /etc/systemd/system/adenai-backup.timer. Status: systemctl list-timers adenai-backup
[Unit]
Description=Nightly Adenai backup

[Timer]
# after the art history backup (03:30) and content snapshot (04:00)
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target

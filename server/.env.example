# ===========================================
# ADENAI ADMIN SERVER - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual values

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username
GITHUB_REPO=your_repository_name

# Server Configuration
NODE_ENV=development
PORT=3001

# Authentication
ADMIN_USERNAME=your_admin_username
# Bcrypt hash of the admin password (never store plaintext passwords).
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# Session Security
SESSION_SECRET=your_long_random_session_secret_key_here

# Optional: Database URLs (if you add database support later)
# DATABASE_URL=your_database_connection_string

# Optional: External API Keys (if you integrate other services)
# EXTERNAL_API_KEY=your_external_api_key
